{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",

  "debugLog": false,
  "permissionReviewLog": false,
  "yoloMode": false,
  "doublePressToConfirm": true,

  "piInfrastructureReadPaths": [
    "~"
  ],

  "permission": {
    "*": "allow",

    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny"
    },

    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "rm -rf *": "deny",
      "rm --recursive*": "deny",
      "rm -r *": "ask",
      "chmod * 777*": "ask",
      "chmod 777*": "ask",
      "chown * 777*": "ask",
      "dd *of=/dev/*": "deny",
      "mkfs*": "deny",
      "fdisk*": "ask",
      "shutdown*": "deny",
      "reboot*": "deny",
      "halt*": "deny",
      "poweroff*": "deny",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git reset --hard*": "ask",
      "git clean -*": "ask",
      "git rebase*": "ask",
      "git commit --amend*": "ask",
      "npm install*": "ask",
      "npm i *": "ask",
      "npm ci*": "ask",
      "npm uninstall*": "ask",
      "pnpm install*": "ask",
      "pnpm add*": "ask",
      "pnpm remove*": "ask",
      "yarn add*": "ask",
      "yarn install*": "ask",
      "yarn remove*": "ask",

      "npm run *": "ask",
      "npm test*": "ask",
      "npm start*": "ask",
      "npm exec *": "ask",
      "npm pack*": "ask",
      "pnpm run *": "ask",
      "pnpm test*": "ask",
      "pnpm exec *": "ask",
      "yarn run *": "ask",
      "yarn test*": "ask",
      "yarn exec *": "ask",

      "make": "ask",
      "make *": "ask",
      "cmake *": "ask",

      "java *": "ask",
      "java -version*": "allow",
      "java --version*": "allow",
      "javac *": "ask",
      "mvn": "ask",
      "mvn *": "ask",
      "gradle": "ask",
      "gradle *": "ask",
      "./mvnw": "ask",
      "./mvnw *": "ask",
      "./gradlew": "ask",
      "./gradlew *": "ask",

      "go build*": "ask",
      "go run*": "ask",
      "go test*": "ask",
      "go install*": "ask",
      "go generate*": "ask",
      "go vet*": "ask",
      "go mod *": "ask",
      "go get *": "ask",

      "python *": "ask",
      "python --version*": "allow",
      "python -V*": "allow",
      "python3 *": "ask",
      "python3 --version*": "allow",
      "python3 -V*": "allow",
      "pip install *": "ask",
      "pip3 install *": "ask",
      "pytest*": "ask",
      "poetry *": "ask",
      "poetry --version*": "allow",
      "uv *": "ask",
      "uv --version*": "allow",
      "pipenv *": "ask",

      "node *": "ask",
      "node --version*": "allow",
      "node -v*": "allow",
      "npx *": "ask",
      "tsx *": "ask",
      "ts-node *": "ask",
      "tsc *": "ask",
      "deno *": "ask",
      "deno --version*": "allow",
      "bun *": "ask",
      "bun --version*": "allow",

      "cargo *": "ask",
      "cargo --version*": "allow",
      "cargo -V*": "allow",
      "cargo fmt*": "allow",
      "cargo clippy*": "allow",
      "rustc *": "ask",
      "rustc --version*": "allow",
      "rustc -V*": "allow",

      "gcc *": "ask",
      "gcc --version*": "allow",
      "g++ *": "ask",
      "g++ --version*": "allow",
      "cc *": "ask",
      "cc --version*": "allow",
      "clang *": "ask",
      "clang --version*": "allow",
      "clang++ *": "ask",
      "clang++ --version*": "allow",

      "curl * | sh": "deny",
      "curl * | bash": "deny",
      "wget * | sh": "deny",
      "wget * | bash": "deny"
    },

    "external_directory": {
      "*": "ask",
      "~/Downloads": "allow",
      "~/Downloads/*": "allow"
    }
  }
}
